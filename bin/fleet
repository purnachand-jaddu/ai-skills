#!/usr/bin/env bash
# Agent fleet entry point. Every task enters through the Haiku router.
#
#   fleet tick              pick up to-do tickets from the tracker and launch workers (cron this)
#   fleet ask "<task>"      ad-hoc request: Haiku files a ticket, classifies, launches
#   fleet status [--all]    runs table
#   fleet kill|retry|cleanup <id>
#   fleet steer <run> "<msg>"   interrupt the worker and redirect it
#   fleet say <run> "<msg>"     message delivered at the end of its current turn
#   fleet stop <run>            end the worker (branch kept)
#   fleet takeover <run>        stop the worker, reopen its session in tmux for you
#   fleet attach <run>          attach your terminal to a taken-over run
#   fleet dashboard         start the web dashboard (foreground)
#   fleet tunnel quick|named|install
set -euo pipefail

AI="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
FLEET_HOME="${FLEET_HOME:-$HOME/.agent-fleet}"
TM="$AI/ticket-manager/tm"
LAUNCH="python3 $AI/agent-launcher/scripts/launch_agent.py"
FLEETPY="python3 $AI/lib/fleet.py"
ROUTER_MODEL="${FLEET_ROUTER_MODEL:-haiku}"
mkdir -p "$FLEET_HOME/dispatcher"

router() {  # router <prompt>
  local log="$FLEET_HOME/dispatcher/$(date -u +%Y%m%dT%H%M%S).log"
  cd "$FLEET_HOME"
  # tm runs in the router's shell, so it needs the key that config.env holds
  KANEO_API_KEY="$(python3 -c "import sys; sys.path.insert(0, '$AI/lib'); import fleet; print(fleet.load_config()['KANEO_API_KEY'])")"
  export KANEO_API_KEY
  claude -p --model "$ROUTER_MODEL" \
    --allowedTools Read Glob Grep Skill \
      "Bash($TM:*)" "Bash($LAUNCH:*)" "Bash($FLEETPY:*)" \
      "Bash(~/codebase/ai-skills/ticket-manager/tm:*)" \
      "Bash(python3 ~/codebase/ai-skills/agent-launcher/scripts/launch_agent.py:*)" \
      "Bash(git -C:*)" "Bash(git log:*)" "Bash(ls:*)" \
    <<<"$1" | tee "$log"
}

with_lock() {  # never run two dispatcher ticks at once (cron overlap)
  exec 9>"$FLEET_HOME/.tick.lock"
  flock -n 9 || { echo "another tick is running"; exit 0; }
}

case "${1:-}" in
  tick)
    with_lock
    free=$($FLEETPY runs --active | python3 -c "
import json,sys,os; sys.path.insert(0,'$AI/lib'); import fleet
print(int(fleet.load_config()['FLEET_MAX_PARALLEL']) - len(json.load(sys.stdin)))")
    [ "$free" -gt 0 ] || { echo "no free slots"; exit 0; }
    tickets=$($FLEETPY pickable)
    [ "$(python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' <<<"$tickets")" -gt 0 ] \
      || { echo "nothing to pick"; exit 0; }
    $FLEETPY emit dispatch.tick --msg "free=$free" >/dev/null
    router "Use the fleet-dispatcher skill in TICK mode. Free worker slots: $free.
Pickable tickets (JSON):
$tickets"
    ;;
  ask)
    shift; [ $# -gt 0 ] || { echo 'usage: fleet ask "<task>"' >&2; exit 1; }
    $FLEETPY emit dispatch.ask --msg "$*" >/dev/null
    router "Use the fleet-dispatcher skill in ASK mode for this request:
$*"
    ;;
  status) shift; $LAUNCH status "$@" ;;
  kill|retry|cleanup) $LAUNCH "$@" ;;
  say|steer|stop|takeover|interrupt|ping)
    op="$1"; run="${2:?run id}"; shift 2; $LAUNCH ctl "$run" "$op" "$@" ;;
  attach) exec tmux attach -t "fleet-${2:?run id}" ;;
  dashboard) exec python3 "$AI/fleet-dashboard/scripts/server.py" ;;
  tunnel) shift; exec bash "$AI/fleet-dashboard/scripts/tunnel.sh" "$@" ;;
  *) sed -n '2,15p' "$0"; exit 1 ;;
esac
