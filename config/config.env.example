# ~/.agent-fleet/config.env — read by every fleet script. Keep it chmod 600.

# Ticket tracker: ticket-manager does the talking; its other settings are in
# ~/.config/ticket-manager/config.toml
KANEO_API_KEY=
# FLEET_PICK_LABEL=agent            # only pick tickets with this label

# This machine's name on ticket comments and events (defaults to hostname)
# FLEET_NODE=vm1

# Fleet limits
FLEET_MAX_PARALLEL=3
FLEET_MAX_ATTEMPTS=1
# FLEET_ROUTER_MODEL=haiku          # env var read by bin/fleet

# Worker permissions: allowlist (default) or bypass (--dangerously-skip-permissions)
FLEET_WORKER_PERMS=allowlist
# FLEET_ALLOWED_TOOLS="Read Edit Write Glob Grep Skill Bash(git:*) Bash(glab:*) Bash(npm:*) ..."

# Dashboard
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
# DASHBOARD_CONTROL=1   # browser steering + takeover terminal (needs token; use Cloudflare Access)
